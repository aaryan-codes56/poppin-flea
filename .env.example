# Copy to .env.local (production values) and never commit real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.poppinflea.in
# Set to "true" only when customer table bookings are open for an edition.
NEXT_PUBLIC_TABLE_BOOKING_ENABLED=false
# Optional: cookieless analytics (plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Storage ---
# "sheets" (default in production) or "local" (default in development, writes .data/*.json)
DATA_DRIVER=
# --- Email ---
# "smtp" (default in production) or "log" (default in development, prints instead of sending)
EMAIL_DRIVER=

# --- Google Sheets (service account with edit access to the sheet) ---
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# --- Gmail (use an App Password, not your account password) ---
EMAIL_USER=
EMAIL_PASS=
# Where new stall enquiry notifications go (defaults to EMAIL_USER)
ORGANISER_EMAIL=

# --- Cloudinary (table-booking payment screenshots) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin auth (generate with: node scripts/hash_password.js "<strong password>") ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional second login with limited rights (no exports / announcements / subscribers)
STAFF_EMAIL=
STAFF_PASSWORD_HASH=
